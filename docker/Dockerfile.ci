# TinkerOS CI Image
FROM ghcr.io/tinkeros/tinkeros/base:latest

LABEL maintainer="TinkerOS Team <team@tinkeros.dev>"
LABEL description="TinkerOS CI Environment"
LABEL version="7.2.0"

USER root

# Install CI tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    cmake \
    ninja-build \
    meson \
    pkg-config \
    \
    # Testing
    python3-pytest \
    python3-pytest-cov \
    python3-pytest-mock \
    python3-hypothesis \
    \
    # Linting
    python3-flake8 \
    python3-black \
    python3-mypy \
    python3-pylint \
    shellcheck \
    \
    # Packaging
    dpkg-dev \
    debhelper \
    devscripts \
    rpm \
    rpm-build \
    \
    # Kernel
    build-essential \
    libncurses-dev \
    bison \
    flex \
    libssl-dev \
    libelf-dev \
    dwarves \
    bc \
    cpio \
    kmod \
    \
    # Virtualization
    qemu-system-x86 \
    qemu-utils \
    ovmf \
    \
    # Documentation
    mkdocs \
    mkdocs-material \
    mkdocs-glightbox \
    mkdocs-mermaid2 \
    \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python CI tools
RUN pip3 install --no-cache-dir \
    pytest \
    pytest-cov \
    pytest-xdist \
    pytest-html \
    coverage \
    codecov \
    black \
    flake8 \
    mypy \
    pylint \
    pre-commit

# Install Node CI tools
RUN npm install -g \
    @commitlint/cli \
    @commitlint/config-conventional \
    semantic-release \
    conventional-changelog-cli

# Configure for CI
USER tinkerer
WORKDIR /home/tinkerer

# Default command
CMD ["/bin/bash"]
