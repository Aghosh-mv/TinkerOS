# TinkerOS Base Image
FROM ubuntu:24.04

LABEL maintainer="TinkerOS Team <team@tinkeros.dev>"
LABEL description="TinkerOS Base Image"
LABEL version="7.2.0"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install base system
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    curl \
    wget \
    git \
    vim \
    htop \
    btop \
    neofetch \
    python3 \
    python3-pip \
    python3-venv \
    ca-certificates \
    gnupg \
    lsb-release \
    software-properties-common \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create tinker user
RUN useradd -m -s /bin/bash -G sudo tinkerer && \
    echo "tinkerer ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/tinkerer

# Set up locale
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Working directory
WORKDIR /home/tinkerer

# Switch to tinker user
USER tinkerer

# Default command
CMD ["/bin/bash"]
