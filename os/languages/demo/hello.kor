# Hello World in Korlang
# Simple test of the compiler

fn main() {
    let name = "KorrinOS"
    let version = 1.3
    
    print("Hello from {name} v{version}!")
    print("Korlang is working!")
    
    # Variables
    let x: i32 = 42
    let y: f64 = 3.14
    let flag: bool = true
    let msg: string = "testing"
    
    # If/else
    if x > 40 {
        print("x is greater than 40")
    } else {
        print("x is 40 or less")
    }
    
    # For loop
    for i in 5 {
        print("count: {i}")
    }
    
    # While loop
    mut counter: i32 = 0
    while counter < 3 {
        print("counter = {counter}")
        counter += 1
    }
    
    # Struct
    let user = User { name: "Alice", age: 30 }
    print("User: {user.name}, Age: {user.age}")
    
    # Function call
    let result = add(10, 20)
    print("10 + 20 = {result}")
}

fn add(a: i32, b: i32) -> i32 {
    return a + b
}

struct User {
    name: string
    age: i32
}
