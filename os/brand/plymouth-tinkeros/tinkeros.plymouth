# Plymouth theme for KorrinOS
# Boot / reboot / restart / shutdown intro: KorrinOS logo on dark background
# with a subtle animated progress bar. This is the Linux-native, most
# effective way to show the branded intro at every boot.

Name=KorrinOS

Description=KorrinOS branded boot/shutdown intro (dark, 3 left-slanting line logo)

ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/korrinos
ScriptFile=/usr/share/plymouth/themes/korrinos/korrinos.script
