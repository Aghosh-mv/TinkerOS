{
  "name": "nibra-betterlife",
  "version": "1.1.0-beta.1",
  "private": false,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --mac dir",
    "test": "node --test tests/agent.test.mjs tests/account-service.test.mjs && node tests/v11-desktop.mjs",
    "build:service": "npm run build && node scripts/build-service.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "life.nibra.desktop",
    "productName": "Nibra BetterLife",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "server/config.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Aghosh-mv",
        "repo": "nibra-betterlife"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "description": "Your private AI copilot for a better digital life.",
  "author": "Nibra",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aghosh-mv/nibra-betterlife.git"
  }
}