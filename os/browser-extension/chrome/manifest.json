{
    "manifest_version": 3,
    "name": "TinkerOS Password Manager",
    "version": "1.0",
    "description": "Secure password generation and storage - YOUR data stays YOURS",
    "permissions": ["activeTab", "storage", "notifications", "scripting"],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}
